# PostgreSQL connection
DATABASE_URL=postgres://onvioo:onvioo@localhost:5432/onvioo

# Kavenegar OTP (verify/lookup). Without these, codes are printed to the server log in development.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# S3-compatible object storage for videos and files (e.g. ArvanCloud)
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=default
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Local testing only: print OTP codes to the server log
# SMS_DRIVER=log

# Optional: Kavenegar lookup template for client notices (message goes in %token10%)
KAVENEGAR_NOTIFY_TEMPLATE=

# Optional: Bale/Telegram bots (Bale works from servers in Iran). The token enables
# private chats with the bot; the chat id adds a team group for notifications.
BALE_BOT_TOKEN=
BALE_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random string in the webhook address, so only Bale/Telegram can post updates
BOT_WEBHOOK_SECRET=
# Public address of the panel, used for links in chat messages
APP_URL=https://panel.example.com

# Local testing only: print bot messages to the server log instead of sending them
# BOT_DRIVER=log

# AI (Claude). From a server in Iran, point ANTHROPIC_BASE_URL at the foreign relay.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://relay.example.com
# ANTHROPIC_MODEL=claude-opus-5-5
# Local testing only: canned AI answers
# AI_DRIVER=mock

# Instagram Graph API. From a server in Iran, point IG_GRAPH_BASE at the relay.
# IG_GRAPH_BASE=https://graph.facebook.com/v23.0
# Optional: the agency's own Business account, used to look up competitors of clients whose page isn't connected
IG_DISCOVERY_USER_ID=
IG_DISCOVERY_TOKEN=
# Encrypts Instagram tokens stored in the database (any long random string; don't change it later)
TOKEN_SECRET=

# Shared secret for the scheduled jobs under /api/cron
CRON_SECRET=

# Online payment (Zarinpal). Without a merchant id, invoices are paid by recording the payment by hand.
ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=1
# Local testing only: a fake gateway at /pay/mock-gateway
# PAYMENT_DRIVER=mock

# Speech to text for automatic subtitles: any OpenAI-compatible Whisper server
# (/v1/audio/transcriptions). Run one on the panel's own server to avoid foreign payments.
WHISPER_URL=
# WHISPER_MODEL=whisper-1
# WHISPER_API_KEY=
# Local testing only: placeholder subtitles
# WHISPER_DRIVER=mock
